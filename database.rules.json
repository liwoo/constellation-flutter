{
  "rules": {
    // Multiplayer rooms. Players sign in anonymously; a room is readable by
    // any signed-in player who knows its code.
    "rooms": {
      "$code": {
        ".read": "auth != null",
        // The whole room is only ever written to open it (into a free code,
        // as its host) or to close it once everyone has left
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (!newData.exists() && !data.child('players').exists()))",
        "hostId": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            // Your own seat only, in a room that exists
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('hostId').exists()",
            // New seats only while the room is in its lobby
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && (data.exists() || newData.parent().parent().child('state').child('status').val() === 'lobby')",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "setup": {
          // Dealt by a player at the table when the match starts
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
          }
        },
        "answers": {
          // Cleared by a player at the table between matches
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "$round": {
            "$uid": {
              // Your own answers only, while seated
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
              "$category": {
                ".validate": "newData.hasChildren(['word', 'points', 'at']) && newData.child('word').isString() && newData.child('word').val().length <= 60 && newData.child('points').isNumber() && newData.child('at').val() === now"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
